# ---------------------------------------------------------------------------
# Wedding Photo Planet CRM — Backend environment template
# Copy to .env and replace every placeholder. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV="development"
# NOTE on macOS: Control Center's AirPlay Receiver listens on 5000. Either turn
# it off (System Settings > General > AirDrop & Handoff) or use another port.
PORT="5000"
API_BASE_PATH="/api/v1"

# --- PostgreSQL ------------------------------------------------------------
# The ONLY supported database engine. MySQL is not supported.
DATABASE_URL="postgresql://postgres:password@localhost:5432/wedding_photo_planet?schema=public"

# Separate database used by `npm test`. It is migrated and truncated by the
# test harness, so it must NEVER point at a database holding real data.
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/wedding_photo_planet_test?schema=public"

# --- Authentication --------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET="replace_me"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="replace_me"
REFRESH_TOKEN_EXPIRES_IN="7d"
# Set to true when the API is served over HTTPS (forces Secure cookies).
COOKIE_SECURE="false"
COOKIE_DOMAIN=""

# --- CORS ------------------------------------------------------------------
# Strict allowlist. Comma-separated. No wildcards are honoured.
CORS_ORIGIN="http://localhost:3000"

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="300"
AUTH_RATE_LIMIT_MAX="10"

# --- Request limits --------------------------------------------------------
JSON_BODY_LIMIT="1mb"
MAX_PAGE_SIZE="100"
DEFAULT_PAGE_SIZE="25"

# --- Logging ---------------------------------------------------------------
LOG_LEVEL="info"

# --- File storage ----------------------------------------------------------
# LOCAL is development-only. DATABASE stores document bytes in PostgreSQL and
# is required in production/serverless deployments.
# One of: LOCAL | DATABASE | S3 | R2 | SUPABASE
STORAGE_PROVIDER="LOCAL"
STORAGE_BUCKET="wedding-photo-planet"
STORAGE_REGION="ap-south-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""
SIGNED_URL_TTL_SECONDS="900"

# --- Seed (development bootstrap only) -------------------------------------
SEED_ORG_NAME="Wedding Photo Planet"
SEED_ORG_SLUG="wedding-photo-planet"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace_me"
# Set to true ONLY on a development machine to load sample CRM records.
SEED_DEMO_DATA="false"
