// ===========================================================================
// PROJECTS — the central entity
// ===========================================================================

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  branchId        String?       @map("branch_id") @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  leadId          String?       @map("lead_id") @db.Uuid
  projectNumber   String        @map("project_number") @db.VarChar(32)
  name            String        @db.VarChar(200)
  type            ProjectType   @default(WEDDING)
  status          ProjectStatus @default(LEAD)
  weddingDate     DateTime?     @map("wedding_date") @db.Date
  deliveryDueDate DateTime?     @map("delivery_due_date") @db.Date
  venueName       String?       @map("venue_name") @db.VarChar(200)
  venueAddress    String?       @map("venue_address") @db.VarChar(255)
  venueCity       String?       @map("venue_city") @db.VarChar(80)
  totalQuotation  Decimal       @default(0) @map("total_quotation") @db.Decimal(14, 2)
  customServiceType String?     @map("custom_service_type") @db.VarChar(160)
  otherClientDetails String?    @map("other_client_details") @db.Text
  notes           String?       @db.Text
  createdById     String?       @map("created_by_id") @db.Uuid
  managerId       String?       @map("manager_id") @db.Uuid
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?       @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  manager      User?        @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  statusHistory  ProjectStatusHistory[]
  events         Event[]
  shoots         Shoot[]
  tasks          Task[]
  deliveries     Delivery[]
  quotations     Quotation[]
  invoices       Invoice[]
  payments       Payment[]
  expenses       Expense[]
  files          FileObject[]
  communications ClientCommunication[]
  attendances    Attendance[]
  paymentMilestones PaymentMilestone[]

  @@unique([organizationId, projectNumber])
  @@index([organizationId, status])
  @@index([organizationId, weddingDate])
  @@index([organizationId, status, deliveryDueDate])
  @@index([clientId])
  @@index([managerId])
  @@index([createdAt])
  @@map("projects")
}

model PaymentMilestone {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  title          String   @db.VarChar(160)
  dueDate        DateTime? @map("due_date") @db.Date
  amount         Decimal  @default(0) @db.Decimal(14, 2)
  status         String   @default("PENDING") @db.VarChar(20)
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
  @@map("payment_milestones")
}

model ProjectStatusHistory {
