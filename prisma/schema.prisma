// ===========================================================================
// TENANCY — Organization > Branch > Users > CRM data
// ===========================================================================

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @db.VarChar(160)
  slug         String             @unique @db.VarChar(80)
  legalName    String?            @map("legal_name") @db.VarChar(200)
  email        String?            @db.VarChar(160)
  phone        String?            @db.VarChar(32)
  website      String?            @db.VarChar(200)
  gstNumber    String?            @map("gst_number") @db.VarChar(32)
  panNumber    String?            @map("pan_number") @db.VarChar(16)
  addressLine  String?            @map("address_line") @db.VarChar(255)
  city         String?            @db.VarChar(80)
  state        String?            @db.VarChar(80)
  postalCode   String?            @map("postal_code") @db.VarChar(16)
  country      String             @default("IN") @db.VarChar(2)
  currency     String             @default("INR") @db.VarChar(3)
  timezone     String             @default("Asia/Kolkata") @db.VarChar(64)
  logoFileId   String?            @map("logo_file_id") @db.Uuid
  status       OrganizationStatus @default(ACTIVE)
  settings     Json?              @db.JsonB
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?            @map("deleted_by") @db.Uuid

  branches         Branch[]
  users            User[]
  roles            Role[]
  leadSources      LeadSource[]
  leads            Lead[]
  clients          Client[]
  projects         Project[]
  eventTypes       EventType[]
  events           Event[]
  shoots           Shoot[]
  departments      Department[]
  designations     Designation[]
  freelancers      Freelancer[]
  tasks            Task[]
  deliveries       Delivery[]
  quotations       Quotation[]
  invoices         Invoice[]
  payments         Payment[]
  expenseCategories ExpenseCategory[]
  expenses         Expense[]
  freelancerPayouts FreelancerPayout[]
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  personalTodos    PersonalTodo[]
  personalNotes    PersonalNote[]
  files            FileObject[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  settingsEntries  SystemSetting[]
  idempotencyKeys  IdempotencyKey[]

  @@index([status])
  @@map("organizations")
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(160)
  code           String    @db.VarChar(32)
  phone          String?   @db.VarChar(32)
  email          String?   @db.VarChar(160)
  addressLine    String?   @map("address_line") @db.VarChar(255)
  city           String?   @db.VarChar(80)
  state          String?   @db.VarChar(80)
  postalCode     String?   @map("postal_code") @db.VarChar(16)
  isHeadOffice   Boolean   @default(false) @map("is_head_office")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  users      User[]
  projects   Project[]
  expenses   Expense[]
  attendances Attendance[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("branches")
}

// ===========================================================================
// IDENTITY, ROLES & PERMISSIONS
// ===========================================================================

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  branchId            String?    @map("branch_id") @db.Uuid
  employeeCode        String?    @map("employee_code") @db.VarChar(32)
  fullName            String     @map("full_name") @db.VarChar(160)
  email               String     @db.VarChar(160)
  phone               String?    @db.VarChar(32)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  status              UserStatus @default(ACTIVE)
  avatarFileId        String?    @map("avatar_file_id") @db.Uuid
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?    @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  employeeProfile EmployeeProfile?

  userRoles          UserRole[]     @relation("UserRoleMember")
  personalRoles      Role[]         @relation("PersonalRole")
  rolesAssignedByMe  UserRole[]     @relation("UserRoleAssignedBy")
  sessions           Session[]
  loginHistories     LoginHistory[]

  createdLeads     Lead[]         @relation("LeadCreatedBy")
  ownedLeads       Lead[]         @relation("LeadOwner")
  leadFollowUps    LeadFollowUp[] @relation("LeadFollowUpOwner")

  clientNotes          ClientNote[]           @relation("ClientNoteAuthor")
  clientCommunications ClientCommunication[]  @relation("ClientCommunicationActor")

  createdProjects      Project[]              @relation("ProjectCreatedBy")
  managedProjects      Project[]              @relation("ProjectManager")
  projectStatusChanges ProjectStatusHistory[] @relation("ProjectStatusChangedBy")

  createdShoots        Shoot[]           @relation("ShootCreatedBy")
  shootAssignments     ShootAssignment[] @relation("ShootAssignmentUser")
  shootAssignmentsMade ShootAssignment[] @relation("ShootAssignmentAssignedBy")

  createdTasks        Task[]               @relation("TaskCreatedBy")
  assignedTasks       Task[]               @relation("TaskAssignee")
  taskAssignmentsTo   TaskAssignment[]     @relation("TaskAssignmentToUser")
  taskAssignmentsFrom TaskAssignment[]     @relation("TaskAssignmentFromUser")
  taskAssignmentsMade TaskAssignment[]     @relation("TaskAssignmentBy")
  taskStatusChanges   TaskStatusHistory[]  @relation("TaskStatusChangedBy")
  workSessions        WorkSession[]

  assignedDeliveries    Delivery[]               @relation("DeliveryAssignee")
  deliveryStatusChanges DeliveryStatusHistory[]  @relation("DeliveryStatusChangedBy")

  createdQuotations Quotation[] @relation("QuotationCreatedBy")
  createdInvoices   Invoice[]   @relation("InvoiceCreatedBy")
  receivedPayments  Payment[]   @relation("PaymentReceivedBy")
  createdExpenses   Expense[]   @relation("ExpenseCreatedBy")
  approvedExpenses  Expense[]   @relation("ExpenseApprovedBy")
  freelancerPayouts FreelancerPayout[] @relation("FreelancerPayoutPaidBy")

  attendances       Attendance[]   @relation("AttendanceUser")
  attendancesMarked Attendance[]   @relation("AttendanceMarkedBy")
  personalTodos     PersonalTodo[]
  personalNotes     PersonalNote[]
  leaveRequests     LeaveRequest[] @relation("LeaveRequestUser")
  leaveReviews      LeaveRequest[] @relation("LeaveRequestReviewer")

  uploadedFiles FileObject[]   @relation("FileUploadedBy")
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditActor")

  @@unique([organizationId, email])
  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([branchId])
  @@index([email])
  @@map("users")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(64)
  description    String?   @db.VarChar(255)
  type           RoleType   @default(CUSTOM)
  status         RoleStatus @default(ACTIVE)
  isDefault      Boolean    @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?   @map("deleted_by") @db.Uuid

  /// Set when the role exists to give one specific employee their own permission
  /// set. Such a role is never offered for anyone else to be assigned.
  personalForUserId String? @map("personal_for_user_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personalFor  User?        @relation("PersonalRole", fields: [personalForUserId], references: [id], onDelete: SetNull)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId, type])
  @@index([personalForUserId])
  @@map("roles")
}

/// Global permission catalogue. Permissions are defined independently of roles
/// so that a role is only ever a named bundle of permission keys.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(80)
  module      String   @db.VarChar(48)
  label       String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  isSensitive Boolean  @default(false) @map("is_sensitive")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User  @relation("UserRoleMember", fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User? @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  refreshTokenHash String        @unique @map("refresh_token_hash") @db.VarChar(128)
  status           SessionStatus @default(ACTIVE)
  ipAddress        String?       @map("ip_address") @db.Inet
  userAgent        String?       @map("user_agent") @db.VarChar(512)
  issuedAt         DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastUsedAt       DateTime      @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokeReason     LogoutReason? @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginHistory {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  email     String       @db.VarChar(160)
  outcome   LoginOutcome
  ipAddress String?      @map("ip_address") @db.Inet
  userAgent String?      @map("user_agent") @db.VarChar(512)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_history")
}

// ===========================================================================
// EMPLOYEE PROFILE (studio staff — distinct from Freelancer)
// ===========================================================================

model Department {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(80)
  description    String?   @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeProfiles EmployeeProfile[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Designation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  title          String    @db.VarChar(80)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeProfiles EmployeeProfile[]

  @@unique([organizationId, title])
  @@map("designations")
}

model EmployeeProfile {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @unique @map("user_id") @db.Uuid
  departmentId     String?         @map("department_id") @db.Uuid
  designationId    String?         @map("designation_id") @db.Uuid
  employmentType   EmploymentType  @default(FULL_TIME) @map("employment_type")
  joiningDate      DateTime?       @map("joining_date") @db.Date
  exitDate         DateTime?       @map("exit_date") @db.Date
  dateOfBirth      DateTime?       @map("date_of_birth") @db.Date
  monthlySalary    Decimal?        @map("monthly_salary") @db.Decimal(14, 2)
  dailyRate        Decimal?        @map("daily_rate") @db.Decimal(14, 2)
  workLocation     WorkLocation    @default(OFFICE) @map("work_location")
  shiftStart       String?         @map("shift_start") @db.VarChar(8)
  shiftEnd         String?         @map("shift_end") @db.VarChar(8)
  weeklyOffDay     Int?            @map("weekly_off_day")
  attendanceRequired Boolean       @default(true) @map("attendance_required")
  reportingManagerId String?       @map("reporting_manager_id") @db.Uuid
  skills           String[]        @default([])
  emergencyContact String?         @map("emergency_contact") @db.VarChar(120)
  addressLine      String?         @map("address_line") @db.VarChar(255)
  city             String?         @db.VarChar(80)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([reportingManagerId])
  @@map("employee_profiles")
}

model StaffSalaryPayment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  paymentMonth   String   @map("payment_month") @db.VarChar(7)
  baseSalary     Decimal  @map("base_salary") @db.Decimal(14, 2)
  paidAmount     Decimal  @default(0) @map("paid_amount") @db.Decimal(14, 2)
  notes          String?  @db.Text
  installments   Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([organizationId, userId, paymentMonth])
  @@index([organizationId, paymentMonth])
  @@map("staff_salary_payments")
}

// ===========================================================================
// CRM — Lead > Qualified > Client > Project
// ===========================================================================

model LeadSource {
  id             String   @id @db.VarChar(64)
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(80)
  description    String?  @db.VarChar(255)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leads Lead[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("lead_sources")
}

model Lead {
