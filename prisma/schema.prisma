  @@index([deliveryId, createdAt])
  @@map("delivery_status_history")
}

// ===========================================================================
// FINANCE
//
// Money is `numeric(14,2)` everywhere — Float is never used.
//
// Source of truth:
//   * Revenue recognised  -> `invoices` + `invoice_items`
//   * Cash received       -> `payments` (immutable once COMPLETED)
//   * Cash applied        -> `payment_allocations`
//   * Cost                -> `expenses` (freelancer payouts included, 1:1)
//
// `invoices.amount_paid` / `amount_due` are DERIVED CACHES. They are only ever
// recomputed from SUM(payment_allocations.amount) inside the same serializable
// transaction that writes an allocation — never incremented in application
// code. See src/services/payment.service.ts.
// ===========================================================================

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  quotationNumber String          @map("quotation_number") @db.VarChar(32)
  projectId       String?         @map("project_id") @db.Uuid
  clientId        String          @map("client_id") @db.Uuid
  issueDate       DateTime        @map("issue_date") @db.Date
  validUntil      DateTime?       @map("valid_until") @db.Date
  subtotal        Decimal         @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal         @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount       Decimal         @default(0) @map("tax_amount") @db.Decimal(14, 2)
  grandTotal      Decimal         @default(0) @map("grand_total") @db.Decimal(14, 2)
  status          QuotationStatus @default(DRAFT)
  notes           String?         @db.Text
  termsAndConditions String?      @map("terms_and_conditions") @db.Text
  createdById     String?         @map("created_by_id") @db.Uuid
  acceptedAt      DateTime?       @map("accepted_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?         @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items QuotationItem[]

  @@unique([organizationId, quotationNumber])
  @@index([projectId])
  @@index([clientId])
  @@index([organizationId, status])
  @@index([issueDate])
  @@map("quotations")
}

model QuotationItem {
  id             String   @id @default(uuid()) @db.Uuid
  quotationId    String   @map("quotation_id") @db.Uuid
  service        String   @db.VarChar(200)
  description    String?  @db.Text
  quantity       Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lineTotal      Decimal  @map("line_total") @db.Decimal(14, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number") @db.VarChar(32)
  projectId      String?       @map("project_id") @db.Uuid
  clientId       String        @map("client_id") @db.Uuid
  quotationId    String?       @map("quotation_id") @db.Uuid
  issueDate      DateTime      @map("issue_date") @db.Date
  dueDate        DateTime?     @map("due_date") @db.Date
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal       @default(0) @db.Decimal(14, 2)
  /// Derived cache: SUM(payment_allocations.amount). Never hand-edited.
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  /// Derived cache: total - amountPaid. Never hand-edited.
  amountDue      Decimal       @default(0) @map("amount_due") @db.Decimal(14, 2)
  status         InvoiceStatus @default(DRAFT)
  notes          String?       @db.Text
  createdById    String?       @map("created_by_id") @db.Uuid
  sentAt         DateTime?     @map("sent_at") @db.Timestamptz(6)
  settledAt      DateTime?     @map("settled_at") @db.Timestamptz(6)
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items       InvoiceItem[]
  allocations PaymentAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@index([projectId])
  @@index([clientId])
  @@index([organizationId, status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  service        String   @db.VarChar(200)
  description    String?  @db.Text
  quantity       Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lineTotal      Decimal  @map("line_total") @db.Decimal(14, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// Immutable once COMPLETED. Corrections are made by recording a REFUNDED or
/// CANCELLED counter-entry — payment rows are never deleted (see §25/§50).
model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  organizationId        String        @map("organization_id") @db.Uuid
  paymentNumber         String        @map("payment_number") @db.VarChar(32)
  projectId             String?       @map("project_id") @db.Uuid
  clientId              String        @map("client_id") @db.Uuid
  amount                Decimal       @db.Decimal(14, 2)
  /// Derived cache: SUM(payment_allocations.amount) for this payment.
  allocatedAmount       Decimal       @default(0) @map("allocated_amount") @db.Decimal(14, 2)
  paymentDate           DateTime      @map("payment_date") @db.Date
  paymentMethod         PaymentMethod @default(UPI) @map("payment_method")
  status                PaymentStatus @default(COMPLETED)
  transactionReference  String?       @map("transaction_reference") @db.VarChar(120)
  receivedById          String?       @map("received_by_id") @db.Uuid
  notes                 String?       @db.Text
  reversalOfPaymentId   String?       @map("reversal_of_payment_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  receivedBy   User?        @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  allocations PaymentAllocation[]

  @@unique([organizationId, paymentNumber])
  @@unique([organizationId, transactionReference])
  @@index([projectId])
  @@index([clientId])
  @@index([paymentDate])
  @@index([organizationId, status])
  @@map("payments")
}

/// One payment may settle several invoices, and one invoice may be settled by
/// several payments. Over-allocation is blocked in the service layer inside a
/// SERIALIZABLE transaction, and by CHECK constraints in the migration SQL.
model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// ===========================================================================
// EXPENSES — project-attributed and general studio cost
// ===========================================================================

model ExpenseCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(80)
  description    String?  @db.VarChar(255)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  expenses Expense[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("expense_categories")
}

model Expense {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  branchId       String?               @map("branch_id") @db.Uuid
  /// NULL = general studio expense. Set = project-attributed cost.
  projectId      String?               @map("project_id") @db.Uuid
  shootId        String?               @map("shoot_id") @db.Uuid
  freelancerId   String?               @map("freelancer_id") @db.Uuid
  categoryId     String                @map("category_id") @db.Uuid
  amount         Decimal               @db.Decimal(14, 2)
  taxAmount      Decimal               @default(0) @map("tax_amount") @db.Decimal(14, 2)
  expenseDate    DateTime              @map("expense_date") @db.Date
  vendor         String?               @db.VarChar(160)
  paymentMethod  PaymentMethod         @default(CASH) @map("payment_method")
  description    String?               @db.Text
  approvalStatus ExpenseApprovalStatus @default(DRAFT) @map("approval_status")
  rejectionReason String?              @map("rejection_reason") @db.VarChar(500)
  createdById    String?               @map("created_by_id") @db.Uuid
  approvedById   String?               @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?             @map("approved_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?             @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?               @map("deleted_by") @db.Uuid

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shoot        Shoot?          @relation(fields: [shootId], references: [id], onDelete: SetNull)
  freelancer   Freelancer?     @relation(fields: [freelancerId], references: [id], onDelete: SetNull)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy    User?           @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   User?           @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  attachments ExpenseAttachment[]
  payout      FreelancerPayout?

  @@index([projectId])
  @@index([categoryId])
  @@index([expenseDate])
  @@index([approvalStatus])
  @@index([organizationId, expenseDate])
  @@map("expenses")
}

model ExpenseAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  expenseId String   @map("expense_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  expense Expense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  file    FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([expenseId, fileId])
  @@index([fileId])
  @@map("expense_attachments")
}

// ===========================================================================
// ATTENDANCE — deliberately kept out of project accounting
// ===========================================================================

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  branchId       String?          @map("branch_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  projectId      String?          @map("project_id") @db.Uuid
  date           DateTime         @db.Date
  checkIn        DateTime?        @map("check_in") @db.Timestamptz(6)
  checkOut       DateTime?        @map("check_out") @db.Timestamptz(6)
  workingMinutes Int              @default(0) @map("working_minutes")
  breakMinutes   Int              @default(0) @map("break_minutes")
  status         AttendanceStatus @default(PRESENT)
  source         AttendanceSource @default(PASSWORD)
  workLocation   WorkLocation     @default(OFFICE) @map("work_location")
  isLate         Boolean          @default(false) @map("is_late")
  notes          String?          @db.Text
  markedById     String?          @map("marked_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user         User         @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  markedBy     User?        @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([organizationId, date])
  @@index([date, status])
  @@index([organizationId, date, status])
  @@map("attendance")
}

model LeaveRequest {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  type           LeaveType   @default(CASUAL)
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime    @map("end_date") @db.Date
  days           Decimal     @db.Decimal(5, 2)
  reason         String?     @db.Text
  status         LeaveStatus @default(PENDING)
  reviewerId     String?     @map("reviewer_id") @db.Uuid
  reviewedAt     DateTime?   @map("reviewed_at") @db.Timestamptz(6)
  reviewNote     String?     @map("review_note") @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("LeaveRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([organizationId, startDate])
  @@map("leave_requests")
}

// ===========================================================================
// FILES — metadata only. Binaries never enter PostgreSQL.
// ===========================================================================

model FileObject {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  uploadedById   String?         @map("uploaded_by_id") @db.Uuid
  entityType     String          @map("entity_type") @db.VarChar(48)
  entityId       String?         @map("entity_id") @db.Uuid
  projectId      String?         @map("project_id") @db.Uuid
  storageProvider StorageProvider @default(LOCAL) @map("storage_provider")
  bucket         String          @db.VarChar(120)
  objectKey      String          @map("object_key") @db.VarChar(512)
  originalName   String          @map("original_name") @db.VarChar(255)
  mimeType       String          @map("mime_type") @db.VarChar(160)
  sizeBytes      BigInt          @map("size_bytes")
  content        Bytes?          @map("content")
  isRegistered   Boolean         @default(true) @map("is_registered")
  checksum       String?         @db.VarChar(128)
  visibility     FileVisibility  @default(PRIVATE)
  metadata       Json?           @db.JsonB
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?         @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  expenseAttachments ExpenseAttachment[]

  @@unique([bucket, objectKey])
  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
  @@index([projectId])
  @@map("files")
}

// ===========================================================================
// NOTIFICATIONS
// ===========================================================================

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  type           NotificationType    @default(GENERAL)
  channel        NotificationChannel @default(IN_APP)
  title          String              @db.VarChar(200)
  message        String              @db.Text
  entityType     String?             @map("entity_type") @db.VarChar(48)
  entityId       String?             @map("entity_id") @db.Uuid
  isRead         Boolean             @default(false) @map("is_read")
  readAt         DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId, userId, isRead])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

// ===========================================================================
// AUDIT LOG — append-only. Secrets are stripped before write (see audit.service).
// ===========================================================================

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  actorId        String?     @map("actor_id") @db.Uuid
  action         AuditAction
  entityType     String      @map("entity_type") @db.VarChar(48)
  entityId       String?     @map("entity_id") @db.Uuid
  summary        String?     @db.VarChar(500)
  oldData        Json?       @map("old_data") @db.JsonB
  newData        Json?       @map("new_data") @db.JsonB
  ipAddress      String?     @map("ip_address") @db.Inet
  userAgent      String?     @map("user_agent") @db.VarChar(512)
  requestId      String?     @map("request_id") @db.VarChar(64)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ===========================================================================
// PLATFORM
// ===========================================================================

model SystemSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(80)
  value          Json     @db.JsonB
  description    String?  @db.VarChar(255)
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("system_settings")
}

/// Guarantees that a retried write (payment, invoice settlement, webhook) can
/// never create a second financial record. The stored response is replayed.
model IdempotencyKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  key            String    @db.VarChar(120)
  endpoint       String    @db.VarChar(160)
  requestHash    String    @map("request_hash") @db.VarChar(64)
  statusCode     Int?      @map("status_code")
  responseBody   Json?     @map("response_body") @db.JsonB
  lockedAt       DateTime  @default(now()) @map("locked_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, endpoint])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
