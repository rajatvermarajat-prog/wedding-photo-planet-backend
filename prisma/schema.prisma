  displayName    String    @map("display_name") @db.VarChar(160)
  primaryPhone   String    @map("primary_phone") @db.VarChar(32)
  primaryEmail   String?   @map("primary_email") @db.VarChar(160)
  brideName      String?   @map("bride_name") @db.VarChar(120)
  groomName      String?   @map("groom_name") @db.VarChar(120)
  gstNumber      String?   @map("gst_number") @db.VarChar(32)
