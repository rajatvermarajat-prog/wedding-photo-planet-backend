  statusHistory TaskStatusHistory[]
  workSessions  WorkSession[]

  @@index([assigneeId, status])
  @@index([status])
  @@index([dueDate])
  @@index([projectId])
  @@index([organizationId, status])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, assigneeId, status])
  @@map("tasks")
}

/// Private checklist that belongs only to the signed-in employee.
