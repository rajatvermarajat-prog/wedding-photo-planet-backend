  notes          String?    @db.Text
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?    @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       LeadSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner        User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

