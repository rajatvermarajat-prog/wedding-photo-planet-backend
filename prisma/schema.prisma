  email          String?    @db.VarChar(160)
  eventType      ProjectType? @map("event_type")
  eventDate      DateTime?  @map("event_date") @db.Date
  venueCity      String?    @map("venue_city") @db.VarChar(80)
  status         LeadStatus @default(NEW)
